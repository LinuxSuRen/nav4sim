<?xml version="1.0"?>
<!-- 30m x 30m ring-corridor building: perimeter loop + central room + pockets.

Test focus:
  - loop closure: driving the ring corridor returns to previously seen
    geometry from a different viewpoint
  - relocalization under landmark aliasing (4 similar corners)
  - dead-end pockets branching off the ring (goal blacklisting)

Topology:
  - Ring corridor ~3.1m wide around the perimeter
  - Central room entered through two opposite 1.7m doorways (N/S)
  - Two dead-end pockets (E/W) with 1.7m entrances

Spawn point: (0, -13.2)  (south corridor)
Suggested goal: central pillar room (0, 0) or a pocket (±9.2, ±4.0).

Generated from a single geometry spec (see PR description); regenerate with:
  python3 gen_loop.py loop_corridor.world
-->
<sdf version="1.6">
  <world name="loop_corridor">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══════════ Outer shell 30m x 30m ═══════════ -->
    <model name="wall_n">
      <pose>0.000 15.000 0.500 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>30.400 0.200 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30.400 0.200 1.000</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <pose>0.000 -15.000 0.500 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>30.400 0.200 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30.400 0.200 1.000</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <pose>15.000 0.000 0.500 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 30.400 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.200 30.400 1.000</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <pose>-15.000 0.000 0.500 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 30.400 1.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.200 30.400 1.000</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════ Central block walls (23m x 23m, ring corridor ~3.1m wide) ═══════════ -->
    <model name="cb_n_left">
      <pose>-6.300 11.600 0.500 0 0 0</pose>
